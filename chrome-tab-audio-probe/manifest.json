{
  "manifest_version": 3,
  "name": "Relay Tab Audio Probe",
  "version": "0.1.0",
  "description": "One-click proof that Chrome can capture the current tab's rendered audio as a MediaStream.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "tabCapture"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Start Relay tab-audio probe"
  }
}
